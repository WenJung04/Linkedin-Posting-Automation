# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (ask @userinfobot). The bot ignores everyone else.
ALLOWED_TELEGRAM_USER_ID=

# From Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Free-tier models change; check AI Studio for a current Flash model name.
GEMINI_MODEL=gemini-3.8-flash
